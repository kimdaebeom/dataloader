<?xml version="1.0"?>
<package format="2">
  <name>dataloader</name>
  <version>0.1.0</version>
  <description>Unified converter and ROS file player for multiple autonomous driving datasets.</description>

  <maintainer email="beom@todo.todo">beom</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>rosgraph_msgs</build_depend>

  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>rosgraph_msgs</build_export_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <!-- Optional at runtime for selected HeLiPR topics:
       - novatel_gps_msgs is required only when publishing inspva.
       - livox_ros_driver is required only when publishing livox_avia. -->

  <export/>
</package>
